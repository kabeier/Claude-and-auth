# Your Supabase project URL (Project Settings > API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe for the browser, but only with row level security on.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Temporary: the one demo user who owns every new project and task until real login exists.
VITE_DEMO_USER_ID=00000000-0000-0000-0000-000000000000
